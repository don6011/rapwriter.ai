# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3024
APP_RELEASE=local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Use only for older Supabase projects that do not expose a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase credentials. Never expose these with NEXT_PUBLIC_ names.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# Server-side AI Gateway. Keep all values private and restart after changes.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_ADVANCED=gpt-5.6-sol
# Optional legacy fallback for OPENAI_MODEL_BALANCED.
# OPENAI_PRODUCER_MODEL=your-model-id

# Billing remains optional until Stripe activation.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Hosted Checkout does not require Stripe.js, but keep this available for future embedded checkout.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Producer HQ uses Stripe Connect Express accounts through STRIPE_SECRET_KEY.
# No Connect OAuth client ID is required for this account-onboarding flow.

# Optional support ticket email notifications. In-app tickets remain authoritative.
RESEND_API_KEY=your-resend-api-key
SUPPORT_FROM_EMAIL=RapWriter Support <support@rapwriter.ai>

# Stripe price variables are resolved dynamically from plan and bundle IDs:
# STRIPE_PRICE_<PLAN_ID>_MONTHLY=price_...
# STRIPE_PRICE_<PLAN_ID>_ANNUAL=price_...
# STRIPE_PRICE_<BUNDLE_ID>_MONTHLY=price_...
# STRIPE_PRICE_<BUNDLE_ID>_ANNUAL=price_...
