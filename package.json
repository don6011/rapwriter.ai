{
  "name": "rapwriter-ai",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test:unit": "bun test src/lib",
    "test:e2e": "playwright test",
    "test:security": "playwright test tests/e2e/security-boundaries.spec.ts --project=desktop-chrome",
    "test:rc": "bun run lint && bun run typecheck && bun run test:unit && bun run test:e2e && bun run build",
    "test:rc:database": "bun run test:rc && bun run test:lifecycle",
    "test:ci": "bun run test:rc",
    "test:access": "bun test src/lib/access-control.test.mjs",
    "test:lifecycle": "node --use-system-ca --env-file=.env.local scripts/test-auth-lifecycle.mjs",
    "test:producer": "bun test src/lib/producer-actions.test.mjs",
    "test:release": "bun test src/lib/producer-release.test.mjs",
    "test:production": "bun run test:unit && bun run test:lifecycle",
    "import:starter-beat": "node --use-system-ca --env-file=.env.local scripts/import-starter-beat.mjs",
    "import:starter-beats": "node --use-system-ca --env-file=.env.local scripts/import-starter-beat-batch.mjs",
    "attach:starter-beat-artwork": "node --use-system-ca --env-file=.env.local scripts/attach-starter-beat-artwork.mjs",
    "sync:membership-plans": "node --use-system-ca --env-file=.env.local scripts/sync-prep-studio-plans.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.575.0",
    "next": "^15.5.7",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "wavesurfer.js": "7.11.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
